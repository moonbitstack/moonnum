name = "moonbitstack/moonnum"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonnum"

license = "Apache-2.0"

keywords = [ "bigint", "float", "complex", "fraction", "format", "number", "moonbit" ]

description = "moonnum — Python's numbers for MoonBit: arbitrary-precision integers, floats, complex numbers and fractions, read, written and formatted as Python reads, writes and formats them. It is not a decimal type and not a bignum encoding."
