// Generated by scripts/gen_fixed_vectors.py from mpmath. Do not edit.
// Every row is an argument and what the reference answers for it; the
// test reads it back and compares within the width's margin.

///|
let vector_bits : Int32 = Fixed::bits_for_digits(50)

///|
let vector_margin : Fixed = Fixed::of_scaled("1", 45, vector_bits)

///|
/// Close when the gap is within the margin: absolute for a small
/// answer, and growing with the answer for a large one, because the
/// fixed-point grid costs a step of the answer's own size.
fn vector_close(got : Fixed, want : Fixed) -> Bool {
  (got - want).abs() <= vector_margin + vector_margin * want.abs()
}

///|
test "expm1 agrees with mpmath at fifty digits" {
  for
    (arg, want) in [
      ("0", "0.0"),
      ("1e-40", "1.00000000000000000000000000000000000000005e-40"),
      ("1e-20", "1.000000000000000000005000000000000000000016666666667e-20"),
      ("1e-8", "0.00000001000000005000000016666666708333333416666666805555556"),
      ("1e-4", "0.000100005000166670833416668055575397073415454172178381"),
      ("0.5", "0.648721270700128146848650787814163571653776100710148"),
      ("-0.5", "-0.393469340287366576396200465008819546558081864512813"),
      ("1", "1.71828182845904523536028747135266249775724709369996"),
      ("-1", "-0.6321205588285576784044762298385391325541888689682322"),
      ("10", "22025.46579480671651695790064528424436635351261855678"),
      ("-10", "-0.9999546000702375151484644084844394493897620819111334"),
      ("100", "26881171418161354484126255515800135873611117.77374192"),
      ("-100", "-0.9999999999999999999999999999999999999999999627992402"),
    ] {
    let got = Fixed::of_decimal(arg, vector_bits).expm1()
    let want_value = Fixed::of_decimal(want, vector_bits)
    assert_true(vector_close(got, want_value))
  }
}

///|
test "log1p agrees with mpmath at fifty digits" {
  for
    (arg, want) in [
      ("0", "0.0"),
      ("1e-40", "9.9999999999999999999999999999999999999995e-41"),
      ("1e-20", "9.999999999999999999950000000000000000000333333333333e-21"),
      ("1e-8", "0.000000009999999950000000333333330833333353333333166666668095"),
      ("1e-4", "0.00009999500033330833533316668095113106348206440107107551"),
      ("0.5", "0.4054651081081643819780131154643491365719904234624942"),
      ("-0.5", "-0.6931471805599453094172321214581765680755001343602553"),
      ("1", "0.6931471805599453094172321214581765680755001343602553"),
      (
        "-0.9999999999999999", "-36.84136148790473094428786327494982732161762381806037",
      ),
      ("10", "2.397895272798370544061943577965129299821706853937417"),
      ("1e10", "23.02585093004045684017491454684397540934432321962107"),
      (
        "-1e-16", "-0.0000000000000001000000000000000050000000000000003333333333333333583",
      ),
    ] {
    let got = Fixed::of_decimal(arg, vector_bits).log1p()
    let want_value = Fixed::of_decimal(want, vector_bits)
    assert_true(vector_close(got, want_value))
  }
}
