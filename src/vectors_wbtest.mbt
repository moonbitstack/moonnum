    ("inf", "+n", "+inf"),
    ("-inf", "+n", "-inf"),
    ("nan", "+n", "+nan"),
    ("2.675e+00", "+n", "+2.675"),
    ("0e+00", "*3.2F", "!malformed"),
    ("-0e+00", "*3.2F", "!malformed"),
    ("1e+00", "*3.2F", "!malformed"),
    ("-1e+00", "*3.2F", "!malformed"),
    ("5e-01", "*3.2F", "!malformed"),
    ("1.2345678e+03", "*3.2F", "!malformed"),
