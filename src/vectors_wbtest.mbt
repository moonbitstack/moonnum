test "vec_floor: 1 of 1" {
  let rows : Array[(String, String, String, String)] = [
    ("2.5e+00", "2", "3", "2"),
    ("-2.5e+00", "-3", "-2", "-2"),
    ("0e+00", "0", "0", "0"),
    ("-0e+00", "0", "0", "0"),
    ("1e+00", "1", "1", "1"),
    ("-1e+00", "-1", "-1", "-1"),
    ("5e-01", "0", "1", "0"),
    ("-5e-01", "-1", "0", "0"),
    ("5e-324", "0", "1", "0"),
    ("-5e-324", "-1", "0", "0"),
    (
      "1e+300", "",
      "",
      "",
    ),
    (
      "-1e+300", "-",
      "-",
      "-",
    ),
    ("1.2349999e+03", "1234", "1235", "1234"),
    ("-1.2349999e+03", "-1235", "-1234", "-1234"),
    ("1e+16", "10000000000000000", "10000000000000000", "10000000000000000"),
    ("-1e+16", "-10000000000000000", "-10000000000000000", "-10000000000000000"),
  ]
  check_floor(rows)
}

