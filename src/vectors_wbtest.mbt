      "-1000000000000000000000000000000", "+n", "-1000000000000000000000000000000",
    ),
    ("0", "*3.2F", "!malformed"),
    ("1", "*3.2F", "!malformed"),
    ("-1", "*3.2F", "!malformed"),
    ("7", "*3.2F", "!malformed"),
