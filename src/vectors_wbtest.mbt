    ("100000000000000000000", "7", "#.0f", "14285714285714285714."),
    ("100000000000000000000", "7", ".3E", "1.429E+19"),
    ("100000000000000000000", "7", "#.4g", "1.429e+19"),
    ("100000000000000000000", "7", "d", "!malformed"),
    ("100000000000000000000", "7", ",", "100,000,000,000,000,000,000/7"),
    ("100000000000000000000", "7", "_", "100_000_000_000_000_000_000/7"),
    ("100000000000000000000", "7", "08,.0f", "14,285,714,285,714,285,714"),
    ("100000000000000000000", "7", "z", "!malformed"),
    ("100000000000000000000", "7", ".2f", "14285714285714285714.29"),
  ]
  check_format_fraction(rows)
}

///|
test "vec_number_parse: 1 of 1" {
  let rows : Array[(String, String)] = [
    ("1", "1"),
    ("-1", "-1"),
    ("0", "0"),
    ("1.5", "1.5"),
    ("1e3", "1000.0"),
    ("3/4", "3/4"),
    ("1+2j", "(1+2j)"),
    ("2j", "2j"),
    ("-0.0", "-0.0"),
    ("0x10", "16"),
    ("inf", "inf"),
    ("nan", "nan"),
    ("1_000", "1000"),
    ("0.1", "0.1"),
    (" 42 ", "42"),
    ("-inf", "-inf"),
    ("1e-3", "0.001"),
    ("(1+2j)", "(1+2j)"),
    ("-3/4", "-3/4"),
    ("0b101", "5"),
    ("j", "1j"),
    ("1e5j", "100000j"),
    ("0x1e", "30"),
    ("1E5j", "100000j"),
    ("2i", "!malformed"),
    ("-0j", "-0j"),
    ("1_0j", "10j"),
    ("1e", "!malformed"),
    ("0o17", "15"),
    ("1.5e2j", "150j"),
  ]
  check_number_parse(rows)
}

///|
test "vec_numbers: 1 of 1" {
  let rows : Array[(String, String, String, String)] = [
    ("1", "1.0", "eq", "True"),
    ("1", "1.0", "cmp", "0"),
    ("1", "1.0", "add", "2.0"),
    ("1", "1.0", "sub", "0.0"),
    ("1", "1.0", "mul", "1.0"),
    ("1", "1.0", "div", "1.0"),
    ("1", "3/4", "eq", "False"),
    ("1", "3/4", "cmp", "1"),
    ("1", "3/4", "add", "7/4"),
    ("1", "3/4", "sub", "1/4"),
    ("1", "3/4", "mul", "3/4"),
    ("1", "3/4", "div", "4/3"),
    ("1", "1+0j", "eq", "True"),
    ("1", "1+0j", "cmp", "!domain"),
    ("1", "1+0j", "add", "(2+0j)"),
    ("1", "1+0j", "sub", "0j"),
    ("1", "1+0j", "mul", "(1+0j)"),
    ("1", "1+0j", "div", "(1+0j)"),
    ("1.5", "3/2", "eq", "True"),
    ("1.5", "3/2", "cmp", "0"),
    ("1.5", "3/2", "add", "3.0"),
    ("1.5", "3/2", "sub", "0.0"),
    ("1.5", "3/2", "mul", "2.25"),
    ("1.5", "3/2", "div", "1.0"),
    ("1e20", "100000000000000000000", "eq", "True"),
    ("1e20", "100000000000000000000", "cmp", "0"),
    ("1e20", "100000000000000000000", "add", "2e+20"),
    ("1e20", "100000000000000000000", "sub", "0.0"),
    ("1e20", "100000000000000000000", "mul", "1e+40"),
    ("1e20", "100000000000000000000", "div", "1.0"),
    ("0.1", "1/10", "eq", "False"),
    ("0.1", "1/10", "cmp", "1"),
    ("0.1", "1/10", "add", "0.2"),
    ("0.1", "1/10", "sub", "0.0"),
    ("0.1", "1/10", "mul", "0.010000000000000002"),
    ("0.1", "1/10", "div", "1.0"),
    ("nan", "nan", "eq", "False"),
    ("nan", "nan", "cmp", "!domain"),
    ("nan", "nan", "add", "nan"),
    ("nan", "nan", "sub", "nan"),
    ("nan", "nan", "mul", "nan"),
    ("nan", "nan", "div", "nan"),
    ("inf", "1e308", "eq", "False"),
    ("inf", "1e308", "cmp", "1"),
    ("inf", "1e308", "add", "inf"),
    ("inf", "1e308", "sub", "inf"),
    ("inf", "1e308", "mul", "inf"),
    ("inf", "1e308", "div", "inf"),
    ("-0.0", "0", "eq", "True"),
    ("-0.0", "0", "cmp", "0"),
    ("-0.0", "0", "add", "0.0"),
    ("-0.0", "0", "sub", "-0.0"),
    ("-0.0", "0", "mul", "-0.0"),
    ("-0.0", "0", "div", "!div0"),
    ("2j", "2j", "eq", "True"),
    ("2j", "2j", "cmp", "!domain"),
    ("2j", "2j", "add", "4j"),
    ("2j", "2j", "sub", "0j"),
    ("2j", "2j", "mul", "(-4+0j)"),
    ("2j", "2j", "div", "(1+0j)"),
  ]
  check_numbers(rows)
}
