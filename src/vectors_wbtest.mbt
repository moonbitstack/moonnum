    ("1e+16", "*3.2F", "!malformed"),
    ("-1e+16", "*3.2F", "!malformed"),
    ("1e-05", "*3.2F", "!malformed"),
    ("1e-04", "*3.2F", "!malformed"),
    ("3.141592653589793e+00", "*3.2F", "!malformed"),
    ("1e+300", "*3.2F", "!malformed"),
    ("5e-324", "*3.2F", "!malformed"),
    ("inf", "*3.2F", "!malformed"),
    ("-inf", "*3.2F", "!malformed"),
    ("nan", "*3.2F", "!malformed"),
    ("2.675e+00", "*3.2F", "!malformed"),
  ]
  check_format_sweep_float(rows)
}

