    ("3+5i", "!malformed"),
    ("1 + 2j", "!malformed"),
    ("  ( 1 + 2j )  ", "!malformed"),
    ("1j", "1j"),
    ("-0-1j", "(-0-1j)"),
    ("nan+infj", "(nan+infj)"),
    ("infj", "infj"),
    ("(nan+nanj)", "(nan+nanj)"),
    ("1", "(1+0j)"),
    ("-1", "(-1+0j)"),
    ("1.5", "(1.5+0j)"),
    ("1+2", "!malformed"),
