test "vec_format_fraction_sweep: 8 of 8" {
  let rows : Array[(String, String, String, String)] = [
    ("-1", "2", "0^+#14,e", "-5.000000e-010"),
    ("100000000000000000000", "7", "0^+#14,e", "+1.428571e+190"),
