///|
test "vec_format_sweep_int: 3 of 53" {
  let rows : Array[(String, String, String)] = [
    ("255", "-<-#012G", "255.000-----"),
    ("1234567", "-<-#012G", "1.23457E+06-"),
    ("-1234567", "-<-#012G", "-1.23457E+06"),
    ("18446744073709551617", "-<-#012G", "1.84467E+19-"),
    ("1000000000000000000000000000000", "-<-#012G", "1.00000E+30-"),
    ("-1000000000000000000000000000000", "-<-#012G", "-1.00000E+30"),
    ("0", "*< 0_.2o", "!malformed"),
    ("1", "*< 0_.2o", "!malformed"),
