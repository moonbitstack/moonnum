    ("0", "<03,F", "0.000000"),
    ("1", "<03,F", "1.000000"),
    ("-1", "<03,F", "-1.000000"),
    ("7", "<03,F", "7.000000"),
    ("-7", "<03,F", "-7.000000"),
    ("255", "<03,F", "255.000000"),
    ("1234567", "<03,F", "1,234,567.000000"),
    ("-1234567", "<03,F", "-1,234,567.000000"),
    ("18446744073709551617", "<03,F", "18,446,744,073,709,551,616.000000"),
    (
      "1000000000000000000000000000000", "<03,F", "1,000,000,000,000,000,019,884,624,838,656.000000",
    ),
    (
      "-1000000000000000000000000000000", "<03,F", "-1,000,000,000,000,000,019,884,624,838,656.000000",
    ),
    ("0", "0= #3,.7g", " 0.000000"),
    ("1", "0= #3,.7g", " 1.000000"),
    ("-1", "0= #3,.7g", "-1.000000"),
    ("7", "0= #3,.7g", " 7.000000"),
    ("-7", "0= #3,.7g", "-7.000000"),
    ("255", "0= #3,.7g", " 255.0000"),
    ("1234567", "0= #3,.7g", " 1,234,567."),
  ]
  check_format_sweep_int(rows)
}

