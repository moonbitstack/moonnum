///|
test "vec_hex_out: 1 of 1" {
  let rows : Array[(String, String)] = [
    ("0e+00", "0x0.0p+0"),
    ("-0e+00", "-0x0.0p+0"),
    ("1e+00", "0x1.0000000000000p+0"),
    ("-1e+00", "-0x1.0000000000000p+0"),
    ("1.5e+00", "0x1.8000000000000p+0"),
    ("1e-01", "0x1.999999999999ap-4"),
    ("5e-324", "0x0.0000000000001p-1022"),
    ("2.2250738585072014e-308", "0x1.0000000000000p-1022"),
    ("1.7976931348623157e+308", "0x1.fffffffffffffp+1023"),
    ("inf", "inf"),
    ("-inf", "-inf"),
    ("nan", "nan"),
    ("3.141592653589793e+00", "0x1.921fb54442d18p+1"),
    ("1e-05", "0x1.4f8b588e368f1p-17"),
    ("1e+16", "0x1.1c37937e08000p+53"),
  ]
  check_hex_out(rows)
}

///|
test "vec_hex_in: 1 of 1" {
  let rows : Array[(String, String)] = [
    ("0x1.0000000000000p+0", "1.0"),
    ("0x1.8p+1", "3.0"),
    ("0x1.921fb54442d18p+1", "3.141592653589793"),
    ("-0x1.999999999999ap-4", "-0.1"),
    ("0x0.0000000000001p-1022", "5e-324"),
    ("0x1p+1023", "8.98846567431158e+307"),
    ("0x1.fffffffffffffp+1023", "1.7976931348623157e+308"),
    ("0x1p-1074", "5e-324"),
    ("0x1p-1075", "0.0"),
    ("1.8p1", "3.0"),
    ("0x.8p0", "0.5"),
    ("0x8.p0", "8.0"),
    ("inf", "inf"),
    ("-inf", "-inf"),
    ("nan", "nan"),
    ("0x1p2000", "!overflow"),
    ("0x1p-2000", "0.0"),
    ("", "!malformed"),
    ("0xg", "!malformed"),
    ("0x1p", "!malformed"),
    ("1.5", "1.3125"),
  ]
  check_hex_in(rows)
}

