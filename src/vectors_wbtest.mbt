    ("1+2j)", "!malformed"),
    ("1_0j", "10j"),
    ("0.1+0.2j", "(0.1+0.2j)"),
  ]
  check_complex_parse(rows)
}

///|
test "vec_complex_ops: 1 of 1" {
  let rows : Array[(String, String, String, String)] = [
    ("add", "1+2j", "3+4j", "(4+6j)"),
    ("sub", "1+2j", "3+4j", "(-2-2j)"),
    ("mul", "1+2j", "3+4j", "(-5+10j)"),
    ("div", "1+2j", "3+4j", "(0.44+0.08j)"),
    ("add", "1+2j", "1-2j", "(2+0j)"),
    ("sub", "1+2j", "1-2j", "4j"),
    ("mul", "1+2j", "1-2j", "(5+0j)"),
    ("div", "1+2j", "1-2j", "(-0.6+0.8j)"),
    ("add", "0j", "1+1j", "(1+1j)"),
    ("sub", "0j", "1+1j", "(-1-1j)"),
    ("mul", "0j", "1+1j", "0j"),
    ("div", "0j", "1+1j", "0j"),
    ("add", "1+0j", "0j", "(1+0j)"),
    ("sub", "1+0j", "0j", "(1+0j)"),
    ("mul", "1+0j", "0j", "0j"),
    ("div", "1+0j", "0j", "!div0"),
    ("add", "-0-1j", "1j", "0j"),
    ("sub", "-0-1j", "1j", "(-0-2j)"),
    ("mul", "-0-1j", "1j", "(1-0j)"),
    ("div", "-0-1j", "1j", "(-1+0j)"),
    ("add", "1e308+1e308j", "1e308+1e308j", "(inf+infj)"),
    ("sub", "1e308+1e308j", "1e308+1e308j", "0j"),
    ("mul", "1e308+1e308j", "1e308+1e308j", "(nan+infj)"),
    ("div", "1e308+1e308j", "1e308+1e308j", "(nan+0j)"),
    ("add", "inf+infj", "1+1j", "(inf+infj)"),
    ("sub", "inf+infj", "1+1j", "(inf+infj)"),
    ("mul", "inf+infj", "1+1j", "(nan+infj)"),
    ("div", "inf+infj", "1+1j", "(inf+nanj)"),
    ("add", "inf+0j", "0+0j", "(inf+0j)"),
    ("sub", "inf+0j", "0+0j", "(inf+0j)"),
    ("mul", "inf+0j", "0+0j", "(nan+nanj)"),
    ("div", "inf+0j", "0+0j", "!div0"),
    ("add", "nan+1j", "1+0j", "(nan+1j)"),
    ("sub", "nan+1j", "1+0j", "(nan+1j)"),
    ("mul", "nan+1j", "1+0j", "(nan+nanj)"),
    ("div", "nan+1j", "1+0j", "(nan+nanj)"),
    ("add", "1+2j", "inf+0j", "(inf+2j)"),
    ("sub", "1+2j", "inf+0j", "(-inf+2j)"),
    ("mul", "1+2j", "inf+0j", "(inf+infj)"),
    ("div", "1+2j", "inf+0j", "0j"),
    ("add", "1+2j", "nan+nanj", "(nan+nanj)"),
    ("sub", "1+2j", "nan+nanj", "(nan+nanj)"),
    ("mul", "1+2j", "nan+nanj", "(nan+nanj)"),
    ("div", "1+2j", "nan+nanj", "(nan+nanj)"),
    ("add", "0j", "0j", "0j"),
    ("sub", "0j", "0j", "0j"),
    ("mul", "0j", "0j", "0j"),
    ("div", "0j", "0j", "!div0"),
    ("abs", "1+2j", "", "2.23606797749979"),
    ("conj", "1+2j", "", "(1-2j)"),
    ("abs", "3-4j", "", "5.0"),
    ("conj", "3-4j", "", "(3+4j)"),
    ("abs", "0j", "", "0.0"),
    ("conj", "0j", "", "-0j"),
    ("abs", "-0-0j", "", "0.0"),
    ("conj", "-0-0j", "", "(-0+0j)"),
    ("abs", "inf+1j", "", "inf"),
    ("conj", "inf+1j", "", "(inf-1j)"),
    ("abs", "nan+1j", "", "nan"),
    ("conj", "nan+1j", "", "(nan-1j)"),
    ("abs", "1e200+1e200j", "", "1.414213562373095e+200"),
    ("conj", "1e200+1e200j", "", "(1e+200-1e+200j)"),
    ("pow", "1+1j", "2+0j", "2j"),
    ("pow", "2j", "2", "(-4+0j)"),
    ("pow", "0j", "0", "(1+0j)"),
    ("pow", "0j", "-1", "!div0"),
    ("pow", "1+0j", "0.5+0j", "(1+0j)"),
    ("pow", "-1+0j", "0.5+0j", "(6.123233995736766e-17+1j)"),
  ]
  check_complex_ops(rows)
}

