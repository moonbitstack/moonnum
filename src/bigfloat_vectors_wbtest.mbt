    ),
    (
      "0.5", "0", "1.",
      "0.0",
    ),
    (
      "-0.5", "0", "2.",
      "0.0",
    ),
    (
      "0", "2", "1.",
      "-1.",
    ),
    (
      "0", "-2", "1.",
      "1.",
    ),
    (
      "3", "-4", "0.",
      "2.",
    ),
    (
      "1", "100", "1.",
      "-5.",
    ),
    (
      "-0.75", "0.25", "2.",
      "-0.",
    ),
    (
      "1e-10", "1e-10", "1.",
      "-0.",
    ),
  ])
}

