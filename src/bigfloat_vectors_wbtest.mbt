///|
test "vec_bc_add at 1000 bits: 1 of 1" {
  check_bc_operation("add", 1000, [
    ("1", "2", "3", "-4", "4.0", "-2.0"),
    (
      "-0.1", "0.5", "0.2", "-0.25", "0.",
      "0.25",
    ),
    (
      "1e10", "-1e-10", "3", "4", "10000000003.0", "3.",
    ),
    ("0.75", "-0.125", "-2", "0.5", "-1.25", "0.375"),
  ])
}

///|
test "vec_bc_sub at 1000 bits: 1 of 1" {
  check_bc_operation("sub", 1000, [
    ("1", "2", "3", "-4", "-2.0", "6.0"),
    (
      "-0.1", "0.5", "0.2", "-0.25", "-0.",
      "0.75",
    ),
    (
      "1e10", "-1e-10", "3", "4", "9999999997.0", "-4.",
    ),
    ("0.75", "-0.125", "-2", "0.5", "2.75", "-0.625"),
  ])
}

///|
test "vec_bc_mul at 1000 bits: 1 of 1" {
  check_bc_operation("mul", 1000, [
    ("1", "2", "3", "-4", "11.0", "2.0"),
    (
      "-0.1", "0.5", "0.2", "-0.25", "0.",
      "0.125",
    ),
    (
      "1e10", "-1e-10", "3", "4", "30000000000.",
      "39999999999.",
    ),
    ("0.75", "-0.125", "-2", "0.5", "-1.4375", "0.625"),
  ])
}

///|
test "vec_bc_div at 1000 bits: 1 of 1" {
  check_bc_operation("div", 1000, [
    (
      "1", "2", "3", "-4", "-0.",
      "0.",
    ),
    (
      "-0.1", "0.5", "0.2", "-0.25", "-1.",
      "0.",
    ),
    (
      "1e10", "-1e-10", "3", "4", "1199999999.",
      "-1600000000.",
    ),
    (
      "0.75", "-0.125", "-2", "0.5", "-0.",
      "-0.",
    ),
  ])
}

///|
test "vec_bc_domain: 1 of 1" {
  check_bc_domain([
    ("divide", "1", "0", "!div0"),
    ("pow", "0", "-1", "!div0"),
    ("pow", "0", "-0.5", "!div0"),
  ])
}

///|
test "vec_bf_domain: 1 of 1" {
  check_bf_domain([
    ("sqrt", "-1", "", "nan"),
    ("sqrt", "-0.5", "", "nan"),
    ("ln", "0", "", "-inf"),
    ("ln", "-1", "", "nan"),
    ("asin", "2", "", "nan"),
    ("acos", "-2", "", "nan"),
    ("acosh", "0.5", "", "nan"),
    ("atanh", "1", "", "inf"),
    ("atanh", "-1", "", "-inf"),
    ("atanh", "2", "", "nan"),
    ("pow", "-2", "0.5", "nan"),
    ("pow", "-2", "3", "-8.0"),
    ("pow", "-2", "2", "4.0"),
    ("pow", "-2", "-3", "-0.125"),
    ("pow", "0", "-1", "inf"),
    ("divide", "1", "0", "!div0"),
    ("div", "1", "0", "inf"),
    ("div", "-1", "0", "-inf"),
    ("div", "0", "0", "nan"),
    ("div", "1", "inf", "0.0"),
    ("mul", "0", "inf", "nan"),
    ("add", "inf", "-inf", "nan"),
    ("add", "inf", "1", "inf"),
    ("sin", "inf", "", "nan"),
    ("exp", "-inf", "", "0.0"),
    ("exp", "inf", "", "inf"),
    ("ln", "inf", "", "inf"),
  ])
}
