      10, "0.0000000001",
    ),
    (
      "0.000000000100000000000000000000000000000031382332551134321431342443082391355086137097707660141565622069492746959440410137176513671875",
      60, "0.000000000100000000000000000000000000000031382332551134321431",
    ),
    (
      "123.456788999999999999999999999974363863359391712607696263426237948124253307469189167022705078125",
      0, "123",
    ),
    (
      "123.456788999999999999999999999974363863359391712607696263426237948124253307469189167022705078125",
      2, "123.46",
    ),
    (
      "123.456788999999999999999999999974363863359391712607696263426237948124253307469189167022705078125",
      10, "123.4567890000",
    ),
